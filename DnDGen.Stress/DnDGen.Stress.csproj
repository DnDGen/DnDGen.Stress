<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageId>DnDGen.Stress</PackageId>
    <Version>5.0.0</Version>
    <Authors>Karl M. Speer</Authors>
    <Company>DnDGen</Company>
    <Product>Stress</Product>
    <Description>A framework for running stress tests against random generators</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DnDGen/DnDGen.Stress</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DnDGen/DnDGen.Stress</RepositoryUrl>
    <PackageTags>dungeons dragons d20 dnd 3.5 generator dndgen stress test nunit load loadtest performance</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>18531-twenty-sided-dice-vector-thumb.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking: now targets .NET 10 (was .NET 8) and depends on NUnit 5.0.0 (was NUnit 4). Updated Microsoft.Extensions.Logging and Microsoft.Extensions.Logging.Console to 10.0.13. Added README to the package.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\DnDGen.Stress\18531-twenty-sided-dice-vector-thumb.png">
      <Pack>True</Pack>
      <PackagePath>
      </PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageReference Include="NUnit" Version="5.0.0" />
  </ItemGroup>
</Project>